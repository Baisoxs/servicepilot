# 复制为 .env 后填写。.env 不进仓库。

# ---- LLM（OpenAI 兼容：DeepSeek / Qwen / GLM / Kimi）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ---- Postgres / pgvector ----
POSTGRES_USER=servicepilot
POSTGRES_PASSWORD=servicepilot
POSTGRES_DB=servicepilot
DATABASE_URL=postgresql+psycopg://servicepilot:servicepilot@localhost:5432/servicepilot

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=servicepilot

# ---- Auth ----
# 生产请换成随机长串：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO
